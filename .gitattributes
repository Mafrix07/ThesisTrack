# Normalise les fins de ligne à LF dans le dépôt, CRLF sur Windows au checkout
* text=auto

# PHP / Twig / Config — toujours LF
*.php text eol=lf
*.twig text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.env text eol=lf

# Binaires — pas de conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
