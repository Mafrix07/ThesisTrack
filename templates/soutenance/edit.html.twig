{% extends 'base.html.twig' %}

{% block title %}Modifier Soutenance{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h2 class="h4 mb-0">Modifier la soutenance de {{ soutenance.etudiant.prenom }} {{ soutenance.etudiant.nom }}</h2>
                </div>
                <div class="card-body">
                    {% if conflict_errors is defined %}
                      {% for error in conflict_errors %}
                        <div class="alert alert-danger">{{ error }}</div>
                      {% endfor %}
                    {% endif %}
                    {{ include('soutenance/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a href="{{ path('app_soutenance_index') }}" class="btn btn-secondary">Retour</a>
                    {{ include('soutenance/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
