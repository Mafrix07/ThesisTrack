{% extends 'base.html.twig' %}

{% block title %}Gestion des Soutenances{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<section class="page-hero">
  <div class="page-hero-inner">
    <h1 class="page-hero-title">Gestion des <em>Soutenances</em></h1>
    <a href="{{ path('app_soutenance_new') }}" class="btn-add">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Programmer une soutenance
    </a>
  </div>
</section>

<main class="page-body">

  {% for message in app.flashes('success') %}
    <div class="tt-flash success">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      {{ message }}
    </div>
  {% endfor %}
  {% for message in app.flashes('danger') %}
    <div class="tt-flash danger">{{ message }}</div>
  {% endfor %}

  <div class="filter-section">
    <div class="filter-head">
      <div class="filter-head-icon">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <span class="filter-head-label">Filtrer par date</span>
    </div>
    <form method="get" class="filter-row">
      <div class="f-group">
        <label class="f-label" for="date">Date de soutenance</label>
        <input id="date" class="f-input" type="date" name="date" value="{{ current_date }}">
      </div>
      <button type="submit" class="btn-filter">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        Filtrer
      </button>
      {% if current_date %}
      <a href="{{ path('app_soutenance_index') }}" class="btn-filter" style="background:#64748b">Tout afficher</a>
      {% endif %}
    </form>
  </div>

  <div class="table-panel">
    <div class="table-toolbar">
      <div class="ttbar-left">
        <span class="ttbar-accent"></span>
        <h2 class="table-title">Soutenances Programmées</h2>
      </div>
      <span class="result-count">{{ soutenances|length }} soutenance(s)</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date &amp; Heure</th>
            <th>Étudiant</th>
            <th>Salle</th>
            <th>Président du jury</th>
            <th>Rapporteur</th>
            <th>Examinateur</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for soutenance in soutenances %}
          <tr>
            <td>
              <span class="tt-badge date-b">{{ soutenance.date|date('d/m/Y') }}</span>
              <span class="tt-badge time-b">{{ soutenance.heure|date('H:i') }}</span>
            </td>
            <td>{{ soutenance.etudiant.prenom }} {{ soutenance.etudiant.nom }}</td>
            <td>{{ soutenance.salle.code }}</td>
            <td>{{ soutenance.president.prenom }} {{ soutenance.president.nom }}</td>
            <td>{{ soutenance.rapporteur.prenom }} {{ soutenance.rapporteur.nom }}</td>
            <td>{{ soutenance.examinateur.prenom }} {{ soutenance.examinateur.nom }}</td>
            <td style="white-space:nowrap">
              <a href="{{ path('app_soutenance_show', {'id': soutenance.id}) }}" class="btn-view">Voir</a>
              <a href="{{ path('app_soutenance_edit', {'id': soutenance.id}) }}" class="btn-edit">Modifier</a>
              <form method="post" action="{{ path('app_soutenance_delete', {'id': soutenance.id}) }}" class="d-inline" onsubmit="return confirm('Annuler cette soutenance ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ soutenance.id) }}">
                <button class="btn-del">Annuler</button>
              </form>
            </td>
          </tr>
          {% else %}
          <tr class="td-empty"><td colspan="7">Aucune soutenance programmée</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</main>
{% endblock %}
