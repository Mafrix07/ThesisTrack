{% extends 'base.html.twig' %}

{% block title %}Gestion des Soutenances{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des Soutenances</h1>
        <a href="{{ path('app_soutenance_new') }}" class="btn btn-primary">Programmer une soutenance</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <input type="date" name="date" class="form-control" value="{{ current_date }}">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">Filtrer par date</button>
                </div>
            </form>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="card mb-4">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Date & Heure</th>
                    <th>Étudiant</th>
                    <th>Salle</th>
                    <th>Président</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for soutenance in soutenances %}
                <tr>
                    <td>
                        <span class="badge bg-primary">{{ soutenance.date|date('d/m/Y') }}</span>
                        <span class="badge bg-secondary">{{ soutenance.heure|date('H:i') }}</span>
                    </td>
                    <td>{{ soutenance.etudiant.prenom }} {{ soutenance.etudiant.nom }}</td>
                    <td>{{ soutenance.salle.code }}</td>
                    <td>{{ soutenance.president.nom }}</td>
                    <td>
                        <a href="{{ path('app_soutenance_show', {'id': soutenance.id}) }}" class="btn btn-sm btn-info">Voir</a>
                        <a href="{{ path('app_soutenance_edit', {'id': soutenance.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">Aucune soutenance programmée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
