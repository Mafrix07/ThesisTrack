{% extends 'base.html.twig' %}

{% block title %}Programmer une Soutenance{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="h4 mb-0">Nouvelle Programmation</h2>
                </div>
                <div class="card-body">
                    {% if conflict_errors is defined %}
                      {% for error in conflict_errors %}
                        <div class="alert alert-danger">{{ error }}</div>
                      {% endfor %}
                    {% endif %}
                    {{ include('soutenance/_form.html.twig') }}
                </div>
                <div class="card-footer">
                    <a href="{{ path('app_soutenance_index') }}" class="btn btn-secondary">Retour</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
