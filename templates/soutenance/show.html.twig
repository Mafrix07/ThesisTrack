{% extends 'base.html.twig' %}

{% block title %}Détails Soutenance{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white text-center">
                    <h2 class="h4 mb-0">Récapitulatif de la Soutenance</h2>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6 text-center">
                            <h5>Date</h5>
                            <p class="h4">{{ soutenance.date|date('d/m/Y') }}</p>
                        </div>
                        <div class="col-md-6 text-center">
                            <h5>Heure</h5>
                            <p class="h4">{{ soutenance.heure|date('H:i') }}</p>
                        </div>
                    </div>

                    <h5 class="border-bottom pb-2">Informations Générales</h5>
                    <table class="table table-borderless">
                        <tr>
                            <th style="width: 30%">Étudiant :</th>
                            <td>{{ soutenance.etudiant.prenom }} {{ soutenance.etudiant.nom }}</td>
                        </tr>
                        <tr>
                            <th>Filière :</th>
                            <td>{{ soutenance.etudiant.filiere }}</td>
                        </tr>
                        <tr>
                            <th>Thème :</th>
                            <td><em>{{ soutenance.etudiant.themeMemoire }}</em></td>
                        </tr>
                        <tr>
                            <th>Salle :</th>
                            <td>{{ soutenance.salle.code }} ({{ soutenance.salle.localisation }})</td>
                        </tr>
                    </table>

                    <h5 class="border-bottom pb-2 mt-4">Composition du Jury</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Président
                            <span class="fw-bold">{{ soutenance.president.prenom }} {{ soutenance.president.nom }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Rapporteur
                            <span class="fw-bold">{{ soutenance.rapporteur.prenom }} {{ soutenance.rapporteur.nom }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Examinateur
                            <span class="fw-bold">{{ soutenance.examinateur.prenom }} {{ soutenance.examinateur.nom }}</span>
                        </li>
                    </ul>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a href="{{ path('app_soutenance_index') }}" class="btn btn-secondary">Retour</a>
                    <a href="{{ path('app_soutenance_edit', {'id': soutenance.id}) }}" class="btn btn-warning">Modifier</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
