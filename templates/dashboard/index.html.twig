{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - SoutenancePro{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<section class="hero">
  <div class="hero-pattern"></div>
  <div class="hero-bar"></div>
  <div class="hero-inner">
    <div>
      <div class="hero-label">
        {% if is_granted('ROLE_ADMIN') %}Administration{% else %}Espace Enseignant{% endif %}
      </div>
      <h1 class="hero-title">
        {% if is_granted('ROLE_ADMIN') %}
          Tableau de<br><em>Bord</em>
        {% else %}
          Mes<br><em>Soutenances</em>
        {% endif %}
      </h1>
      <p class="hero-sub">Bienvenue, {{ app.user.prenom }} {{ app.user.nom }}.</p>
    </div>
  </div>
</section>

<main class="page-body">

  {% if is_granted('ROLE_ADMIN') %}
  <div class="kpi-grid">
    <a href="{{ path('app_etudiant_index') }}" class="kpi-card k-etudiants" data-icon="🎓">
      <div class="kpi-top">
        <div class="kpi-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <span class="kpi-pill">Total</span>
      </div>
      <div class="kpi-num">{{ stats.etudiants }}</div>
      <div class="kpi-label">Étudiants</div>
    </a>

    <a href="{{ path('app_enseignant_index') }}" class="kpi-card k-enseignants" data-icon="👨‍🏫">
      <div class="kpi-top">
        <div class="kpi-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <span class="kpi-pill">Corps</span>
      </div>
      <div class="kpi-num">{{ stats.enseignants }}</div>
      <div class="kpi-label">Enseignants</div>
    </a>

    <a href="{{ path('app_salle_index') }}" class="kpi-card k-salles" data-icon="🏛">
      <div class="kpi-top">
        <div class="kpi-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <span class="kpi-pill">Disponibles</span>
      </div>
      <div class="kpi-num">{{ stats.salles }}</div>
      <div class="kpi-label">Salles</div>
    </a>

    <a href="{{ path('app_soutenance_index') }}" class="kpi-card k-soutenances" data-icon="📋">
      <div class="kpi-top">
        <div class="kpi-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <span class="kpi-pill">Programmées</span>
      </div>
      <div class="kpi-num">{{ stats.soutenances }}</div>
      <div class="kpi-label">Soutenances</div>
    </a>
  </div>
  {% endif %}

  {% if is_granted('ROLE_ENSEIGNANT') %}
  <div class="kpi-grid" style="grid-template-columns: repeat(3,1fr)" id="mes-jurys">
    <div class="kpi-card k-soutenances" data-icon="⚖">
      <div class="kpi-top">
        <div class="kpi-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>
        </div>
        <span class="kpi-pill">Jurys</span>
      </div>
      <div class="kpi-num">{{ enseignant_data.count }}</div>
      <div class="kpi-label">Participations jury</div>
    </div>
  </div>

  <div class="table-panel" id="mes-etudiants">
    <div class="table-toolbar">
      <div class="ttbar-left">
        <span class="ttbar-accent"></span>
        <h2 class="table-title">Mes Étudiants Concernés</h2>
      </div>
      <span class="result-count">{{ enseignant_data.soutenances|length }} étudiant(s)</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Filière</th>
            <th>Thème du mémoire</th>
          </tr>
        </thead>
        <tbody>
          {% for soutenance in enseignant_data.soutenances %}
          <tr>
            <td>{{ soutenance.etudiant.nom }}</td>
            <td>{{ soutenance.etudiant.prenom }}</td>
            <td>{{ soutenance.etudiant.filiere }}</td>
            <td>{{ soutenance.etudiant.themeMemoire }}</td>
          </tr>
          {% else %}
          <tr class="td-empty"><td colspan="4">Aucun étudiant associé</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="table-panel" id="mes-soutenances">
    <div class="table-toolbar">
      <div class="ttbar-left">
        <span class="ttbar-accent"></span>
        <h2 class="table-title">Mes Soutenances Programmées</h2>
      </div>
      <span class="result-count">{{ enseignant_data.count }} soutenance(s)</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date &amp; Heure</th>
            <th>Étudiant</th>
            <th>Thème</th>
            <th>Salle</th>
            <th>Mon rôle</th>
          </tr>
        </thead>
        <tbody>
          {% for soutenance in enseignant_data.soutenances %}
          <tr>
            <td>
              <span class="tt-badge date-b">{{ soutenance.date|date('d/m/Y') }}</span>
              <span class="tt-badge time-b">{{ soutenance.heure|date('H:i') }}</span>
            </td>
            <td>{{ soutenance.etudiant.prenom }} {{ soutenance.etudiant.nom }}</td>
            <td>{{ soutenance.etudiant.themeMemoire }}</td>
            <td>{{ soutenance.salle.code }} — {{ soutenance.salle.localisation }}</td>
            <td>
              {% if soutenance.president.user and soutenance.president.user.id == app.user.id %}
                <span class="tt-badge president">Président</span>
              {% elseif soutenance.rapporteur.user and soutenance.rapporteur.user.id == app.user.id %}
                <span class="tt-badge rapporteur">Rapporteur</span>
              {% elseif soutenance.examinateur.user and soutenance.examinateur.user.id == app.user.id %}
                <span class="tt-badge examinateur">Examinateur</span>
              {% endif %}
            </td>
          </tr>
          {% else %}
          <tr class="td-empty"><td colspan="5">Aucune soutenance programmée</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

</main>
{% endblock %}
