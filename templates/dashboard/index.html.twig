{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - SoutenancePro{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>Bienvenue sur SoutenancePro</h1>
            <p class="lead">Votre plateforme de gestion des soutenances.</p>
        </div>
    </div>
    
    <div class="row mt-4">
        {% if is_granted('ROLE_ADMIN') %}
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Étudiants</h5>
                    <p class="card-text">Gérez les dossiers étudiants.</p>
                    <a href="{{ path('app_etudiant_index') }}" class="btn btn-light">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Enseignants</h5>
                    <p class="card-text">Gérez le corps professoral.</p>
                    <a href="{{ path('app_enseignant_index') }}" class="btn btn-light">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Salles</h5>
                    <p class="card-text">Gérez les salles de soutenance.</p>
                    <a href="{{ path('app_salle_index') }}" class="btn btn-light">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-dark mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Soutenances</h5>
                    <p class="card-text">Planifiez les examens.</p>
                    <a href="{{ path('app_soutenance_index') }}" class="btn btn-light">Voir</a>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
