{% extends 'base.html.twig' %}

{% block title %}Gestion des Enseignants{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<section class="page-hero">
  <div class="page-hero-inner">
    <h1 class="page-hero-title">Liste des <em>Enseignants</em></h1>
    <a href="{{ path('app_enseignant_new') }}" class="btn-add">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Ajouter un enseignant
    </a>
  </div>
</section>

<main class="page-body">

  {% for message in app.flashes('success') %}
    <div class="tt-flash success">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      {{ message }}
    </div>
  {% endfor %}
  {% for message in app.flashes('danger') %}
    <div class="tt-flash danger">{{ message }}</div>
  {% endfor %}

  <div class="table-panel">
    <div class="table-toolbar">
      <div class="ttbar-left">
        <span class="ttbar-accent"></span>
        <h2 class="table-title">Corps Enseignant</h2>
      </div>
      <span class="result-count">{{ enseignants|length }} enseignant(s)</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Email</th>
            <th>Spécialité</th>
            <th>Compte lié</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for enseignant in enseignants %}
          <tr>
            <td>{{ enseignant.nom }}</td>
            <td>{{ enseignant.prenom }}</td>
            <td>{{ enseignant.email }}</td>
            <td>{{ enseignant.specialite }}</td>
            <td>
              {% if enseignant.user %}
                <span class="tt-badge linked">{{ enseignant.user.email }}</span>
              {% else %}
                <span class="tt-badge none">Aucun</span>
              {% endif %}
            </td>
            <td style="white-space:nowrap">
              <a href="{{ path('app_enseignant_show', {'id': enseignant.id}) }}" class="btn-view">Voir</a>
              <a href="{{ path('app_enseignant_edit', {'id': enseignant.id}) }}" class="btn-edit">Modifier</a>
              <form method="post" action="{{ path('app_enseignant_delete', {'id': enseignant.id}) }}" class="d-inline"
                    data-confirm="Supprimer l'enseignant {{ enseignant.prenom }} {{ enseignant.nom }} ? Il sera retiré de tous les jurys.">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enseignant.id) }}">
                <button class="btn-del">Supprimer</button>
              </form>
            </td>
          </tr>
          {% else %}
          <tr class="td-empty"><td colspan="6">Aucun enseignant enregistré</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</main>
{% endblock %}
