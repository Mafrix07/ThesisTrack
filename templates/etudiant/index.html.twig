{% extends 'base.html.twig' %}

{% block title %}Gestion des Étudiants{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des Étudiants</h1>
        <a href="{{ path('app_etudiant_new') }}" class="btn btn-primary">Ajouter un étudiant</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="search" class="form-control" placeholder="Rechercher par nom ou prénom..." value="{{ search }}">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Filière</th>
                    <th>Thème</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for etudiant in etudiants %}
                <tr>
                    <td>{{ etudiant.nom }}</td>
                    <td>{{ etudiant.prenom }}</td>
                    <td>{{ etudiant.email }}</td>
                    <td>{{ etudiant.filiere }}</td>
                    <td>{{ etudiant.themeMemoire }}</td>
                    <td>
                        <a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}" class="btn btn-sm btn-info">Voir</a>
                        <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucun étudiant trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
