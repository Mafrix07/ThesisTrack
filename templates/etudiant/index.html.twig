{% extends 'base.html.twig' %}

{% block title %}Gestion des Étudiants{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<section class="page-hero">
  <div class="page-hero-inner">
    <h1 class="page-hero-title">Liste des <em>Étudiants</em></h1>
    <a href="{{ path('app_etudiant_new') }}" class="btn-add">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Ajouter un étudiant
    </a>
  </div>
</section>

<main class="page-body">

  {% for message in app.flashes('success') %}
    <div class="tt-flash success">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      {{ message }}
    </div>
  {% endfor %}
  {% for message in app.flashes('danger') %}
    <div class="tt-flash danger">{{ message }}</div>
  {% endfor %}

  <div class="filter-section">
    <div class="filter-head">
      <div class="filter-head-icon">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      <span class="filter-head-label">Recherche</span>
    </div>
    <form method="get" class="filter-row">
      <div class="f-group">
        <label class="f-label" for="search">Nom ou prénom</label>
        <input id="search" class="f-input" type="text" name="search" placeholder="Rechercher par nom ou prénom…" value="{{ search }}">
      </div>
      <button type="submit" class="btn-filter">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Rechercher
      </button>
      {% if search %}
      <a href="{{ path('app_etudiant_index') }}" class="btn-filter" style="background:#64748b">Tout afficher</a>
      {% endif %}
    </form>
  </div>

  <div class="table-panel">
    <div class="table-toolbar">
      <div class="ttbar-left">
        <span class="ttbar-accent"></span>
        <h2 class="table-title">Tous les Étudiants</h2>
      </div>
      <span class="result-count">{{ etudiants|length }} résultat(s)</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Email</th>
            <th>Filière</th>
            <th>Thème du mémoire</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for etudiant in etudiants %}
          <tr>
            <td>{{ etudiant.nom }}</td>
            <td>{{ etudiant.prenom }}</td>
            <td>{{ etudiant.email }}</td>
            <td>{{ etudiant.filiere }}</td>
            <td>{{ etudiant.themeMemoire }}</td>
            <td style="white-space:nowrap">
              <a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}" class="btn-view">Voir</a>
              <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="btn-edit">Modifier</a>
              <form method="post" action="{{ path('app_etudiant_delete', {'id': etudiant.id}) }}" class="d-inline"
                    data-confirm="Supprimer l'étudiant {{ etudiant.prenom }} {{ etudiant.nom }} ? Cette action est irréversible.">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etudiant.id) }}">
                <button class="btn-del">Supprimer</button>
              </form>
            </td>
          </tr>
          {% else %}
          <tr class="td-empty"><td colspan="6">Aucun étudiant trouvé</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</main>
{% endblock %}
