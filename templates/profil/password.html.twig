{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<section class="page-hero">
  <div class="page-hero-inner">
    <h1 class="page-hero-title">Changer mon <em>Mot de Passe</em></h1>
    <a href="{{ path('app_dashboard') }}" class="btn btn-secondary btn-sm">Retour</a>
  </div>
</section>

<main class="page-body">

  {% for message in app.flashes('success') %}
    <div class="tt-flash success">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      {{ message }}
    </div>
  {% endfor %}
  {% for message in app.flashes('danger') %}
    <div class="tt-flash danger">{{ message }}</div>
  {% endfor %}

  <div style="max-width:500px;margin:0 auto">
    <div class="card shadow border-0" style="border-radius:16px;overflow:hidden">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Sécurité du compte</h5>
        <small class="opacity-75">{{ app.user.email }}</small>
      </div>
      <div class="card-body p-4">
        {{ form_start(form) }}
          <div class="mb-3">{{ form_row(form.currentPassword) }}</div>
          <hr>
          <div class="mb-3">{{ form_row(form.newPassword.first) }}</div>
          <div class="mb-4">{{ form_row(form.newPassword.second) }}</div>
          {{ form_errors(form.newPassword) }}
          <div class="d-grid">
            <button class="btn btn-primary">Enregistrer le nouveau mot de passe</button>
          </div>
        {{ form_end(form) }}
      </div>
    </div>
  </div>

</main>
{% endblock %}
